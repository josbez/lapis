{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lapis",
  "version": "0.3.0",
  "identifier": "dev.lapis.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lapis",
        "width": 1100,
        "height": 760,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: asset: http://asset.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "public.app-category.productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyQzk3MzcxQUM5QjhDMTcKUldRWGpKdXNjWFBKb3NNUFVBL2cydDl3dmduOGFQUVdDYVVydVdKdUFGSTdSUnZOL2RzRFN3Ly8K",
      "endpoints": [
        "https://github.com/josbez/lapis/releases/latest/download/latest.json"
      ]
    }
  }
}
